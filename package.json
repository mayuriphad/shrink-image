{
  "name": "shrink-image",
  "version": "1.0.0",
  "type": "module",
  "description": "Client-side browser image compression, resizing and WebP conversion. Shrinks large phone photos to a size you choose before uploading to your server or S3.",
  "author": "Mayuri Phad <mayuriphad656@gmail.com>",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "image-compression",
    "image-resize",
    "compress",
    "webp",
    "browser",
    "client-side",
    "react",
    "angular",
    "canvas",
    "upload",
    "s3"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayuriphad/shrink-image.git"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
